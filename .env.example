# Copy to .env and fill in for a real deployment. Local docker-compose runs
# fully without any of these set (USE_MOCK_AI defaults on, Indeed falls back
# to seed data, auth defaults to dev mode).

# --- AI ---
GEMINI_API_KEY=
USE_MOCK_AI=false

# --- Indeed (official, ToS-permitted primary ingestion path) ---
INDEED_PUBLISHER_ID=
INDEED_API_KEY=

# --- LinkedIn fallback (ToS risk -- see architecture report section 7) ---
# Leave false unless there has been an explicit legal risk-acceptance sign-off.
ENABLE_LINKEDIN_SCRAPE=false

# --- Auth (Cloud Run deploy) ---
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=

# --- GCP project (for infra/terraform) ---
GCP_PROJECT_ID=
GCP_REGION=us-central1
